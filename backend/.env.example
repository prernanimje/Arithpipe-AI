# Cloud PostgreSQL Database URL (Render, Railway, Supabase, Neon)
# If provided, DATABASE_URL takes priority over individual DB_* variables
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Individual PostgreSQL credentials (Local development fallback)
DB_NAME=arithpipe
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key

# CORS Allowed Origins (Comma-separated for production frontend domains)
# e.g. https://your-frontend.vercel.app,https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
